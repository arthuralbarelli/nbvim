#cells {
    height: 1fr;
}

.notebook-cell {
    height: auto;
    margin-bottom: 1;
    border: solid transparent;
}

.cell-editor {
    width: 1fr;
    height: auto;
}

.cell-markdown {
    width: 100%;
    height: auto;
    min-height: 4;
    padding: 0 1;
}

.cell-output {
    width: 100%;
    height: auto;
    min-height: 0;
    padding: 0 1;
    color: $text;
}

.cell-output-image {
    /* textual-image treats a non-auto width as an already-resolved cell
       count (content_size.width). width: 100% is often 0 during the first
       layout pass, which collapses TGP/Sixel images to 0x0. auto uses the
       parent max width and keeps aspect ratio. */
    width: auto;
    height: auto;
}

.cell-output-text {
    width: 100%;
    height: auto;
}

.cell-footer {
    width: 100%;
    height: 1;
    text-align: right;
    padding-right: 1;
    color: $text-muted;
}

.notebook-cell:focus-within {
    border: solid white;
}

.marker {
    width: 5;
    min-width: 5;
    padding: 1 1;
}

TextArea {
    width: 100%;
    height: 4;
    min-height: 4;
    scrollbar-size: 0 0;
}

#command-bar {
    dock: bottom;
    width: 100%;
    height: 1;
    padding: 0 1;
    border: none;
    background: #2b2b2b;
    display: none;
}

#command-bar:focus {
    border: none;
    background: #2b2b2b;
}
