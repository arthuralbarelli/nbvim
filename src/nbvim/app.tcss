#cells {
    height: 1fr;
}

.notebook-cell {
    height: auto;
    margin-bottom: 1;
    border: solid transparent;
}

.cell-editor {
    width: 1fr;
    height: auto;
}

.cell-markdown {
    width: 100%;
    height: auto;
    min-height: 4;
    padding: 0 1;
}

.cell-output {
    width: 100%;
    height: auto;
    min-height: 0;
    padding: 0 1;
    color: $text;
}

.cell-output-image {
    /* textual-image: non-auto width is a cell count, so 100% can be 0x0. */
    width: auto;
    height: auto;
}

.cell-output-text {
    width: 100%;
    height: auto;
}

.cell-footer {
    width: 100%;
    height: 1;
    text-align: right;
    padding-right: 1;
    color: $text-muted;
}

.notebook-cell:focus-within {
    border: solid white;
}

.marker {
    width: 5;
    min-width: 5;
    padding: 1 1;
}

TextArea {
    width: 100%;
    height: 4;
    min-height: 4;
    scrollbar-size: 0 0;
}

#command-bar {
    dock: bottom;
    width: 100%;
    height: 1;
    padding: 0 1;
    border: none;
    background: #2b2b2b;
    display: none;
}

#command-bar:focus {
    border: none;
    background: #2b2b2b;
}
